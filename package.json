{
  "name": "@gojogs/lisense",
  "version": "1.0.0",
  "description": "Create standard LICENSE files for your software projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gojoGS/lisense.git"
  },
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "lisense": "src/index.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "link": "bun link",
    "pack": "bun pm pack"
  },
  "keywords": [
    "license",
    "licenses",
    "cli",
    "spdx",
    "license-file"
  ],
  "license": "GPL-2.0-only",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "spdx-license-list": "^6.12.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
